{
  "name": "playground-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "tunnel": "node scripts/tunnel.js 5173",
    "dev:tunnel": "concurrently -n \"FE,TUNNEL\" -c \"green,cyan\" \"vite --port 5173\" \"node scripts/tunnel.js 5173\"",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "@line/liff": "^2.30.0",
    "@lucide/vue": "^1.34.0",
    "@vuepic/vue-datepicker": "^14.0.0",
    "axios": "^1.7.2",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "driver.js": "^1.8.0",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^2.1.7",
    "qrcode": "^1.5.4",
    "radix-vue": "^1.9.17",
    "sweetalert2": "^11.26.25",
    "tailwind-merge": "^3.6.0",
    "vue": "^3.4.29",
    "vue-chartjs": "^5.3.4",
    "vue-router": "^4.3.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-vue": "^5.0.5",
    "@vue/test-utils": "^2.5.0",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.5",
    "happy-dom": "^20.12.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "vite": "^5.3.1",
    "vitest": "^4.1.11"
  }
}
